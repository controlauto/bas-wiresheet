    "entity_input": {
      "label": "Entity Input",
      "category": "Inputs",
      "description": "Reads one Home Assistant entity. Outputs its value and the raw sample with timestamps.",
      "inputs": [],
      "outputs": [
        {
          "id": "value",
          "label": "Value",
          "type": {
            "param": "value_type"
          },
          "unit": {
            "param": "unit"
          }
        },
        {
          "id": "sample",
          "label": "Sample",
          "type": "sample"
        }
      ],
      "params": [
        {
          "id": "entity_id",
          "label": "Entity",
          "kind": "entity",
          "required": true
        },
        {
          "id": "value_type",
          "label": "Value Type",
          "kind": "enum",
          "options": [
            "number",
            "boolean"
          ],
          "default": "number"
        },
        {
          "id": "unit",
          "label": "Unit",
          "kind": "string",
          "default": ""
        },
        {
          "id": "valid_min",
          "label": "Valid Min",
          "kind": "number",
          "default": null
        },
        {
          "id": "valid_max",
          "label": "Valid Max",
          "kind": "number",
          "default": null
        },
        {
          "id": "equipment",
          "label": "Equipment",
          "kind": "string",
          "default": ""
        },
        {
          "id": "sample_evidence",
          "label": "Sample Evidence",
          "kind": "enum",
          "options": [
            "changes_only",
            "reports_every_sample",
            "value_changes_each_sample"
          ],
          "default": "changes_only",
          "help": "How the source integration writes states. changes_only: unchanged samples are not written, so new-sample arrival cannot be proven once the value is steady. reports_every_sample: every sample is written (last_reported advances even if unchanged). value_changes_each_sample: the value itself changes on every sample (e.g. a countdown)."
        },
        {
          "id": "rest_values",
          "label": "Rest Values",
          "kind": "list",
          "default": [],
          "help": "Only for value_changes_each_sample: values at which the source can legitimately stop changing."
        }
      ]
    },
