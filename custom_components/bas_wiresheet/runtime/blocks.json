    "on_delay": {
      "label": "On Delay",
      "category": "Timers",
      "description": "Output turns true after the input has been true continuously for the delay. Resets when the input is false or invalid.",
      "inputs": [
        {
          "id": "in",
          "label": "In",
          "type": "boolean",
